<?xml version="1.0" encoding="utf-8"?>
<xs:schema elementFormDefault="qualified" xmlns:xs="http://www.w3.org/2001/XMLSchema">
  <xs:annotation>
    <xs:documentation xml:lang="vi">BlueMeal — lược đồ XML của API công khai /api/v1/public (Accept: application/xml), theo Thông tư 39/2017/TT-BTTTT. Số thập phân dùng dấu chấm; ngày dạng yyyy-MM-dd; thời điểm ISO 8601 UTC. Phần tử có nillable="true" nhận xsi:nil="true" khi không có giá trị.</xs:documentation>
  </xs:annotation>
  <xs:element name="token" nillable="true" type="TokenResponse" />
  <xs:complexType name="TokenResponse">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="AccessToken" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="TokenType" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="ExpiresIn" type="xs:int" />
      <xs:element minOccurs="0" maxOccurs="1" name="Scope" type="xs:string" />
    </xs:sequence>
  </xs:complexType>
