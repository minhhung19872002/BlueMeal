      <xs:element minOccurs="1" maxOccurs="1" name="PercentOfTarget" nillable="true" type="xs:decimal" />
      <xs:element minOccurs="1" maxOccurs="1" name="DaysMet" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="DaysNotMet" type="xs:int" />
    </xs:sequence>
