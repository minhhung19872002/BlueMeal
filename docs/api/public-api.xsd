      <xs:element minOccurs="0" maxOccurs="1" name="Subject" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="Servings" type="xs:int" />
      <xs:element minOccurs="1" maxOccurs="1" name="EnergyKcal" nillable="true" type="xs:decimal" />
      <xs:element minOccurs="0" maxOccurs="1" name="Dishes" type="ArrayOfPublicDish" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ArrayOfPublicDish">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="dish" nillable="true" type="PublicDish" />
