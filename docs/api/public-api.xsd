      <xs:element minOccurs="1" maxOccurs="1" name="TotalItems" type="xs:long" />
      <xs:element minOccurs="0" maxOccurs="unbounded" name="food" type="food" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="food">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="1" name="Code" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="Name" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="NameEn" type="xs:string" />
      <xs:element minOccurs="0" maxOccurs="1" name="Group" type="xs:string" />
      <xs:element minOccurs="1" maxOccurs="1" name="RefuseRate" type="xs:decimal" />
      <xs:element minOccurs="0" maxOccurs="1" name="Source" type="xs:string" />
