      <xs:element minOccurs="0" maxOccurs="1" name="Per100g" type="ArrayOfPublicFoodNutrient" />
    </xs:sequence>
  </xs:complexType>
  <xs:complexType name="ArrayOfPublicFoodNutrient">
    <xs:sequence>
      <xs:element minOccurs="0" maxOccurs="unbounded" name="nutrient" nillable="true" type="PublicFoodNutrient" />
    </xs:sequence>
  </xs:complexType>
