# ======================================================================
# BlueMeal — environment template. Copy to deploy/.env and CHANGE EVERY SECRET.
# Never commit deploy/.env. Generate secrets with scripts/gen-secrets.ps1 (or .sh).
# ======================================================================
COMPOSE_PROJECT_NAME=bluemeal
BLUEMEAL_VERSION=1.0.0
ASPNETCORE_ENVIRONMENT=Production

# --- Public URL used in emails (password reset links)
BLUEMEAL_PUBLIC_URL=https://bluemeal.example.vn
SERVER_NAME=_
HTTP_PORT=80
HTTPS_PORT=443
TLS_REDIRECT=on
AUTH_COOKIE_SECURE=true

# --- PostgreSQL: superuser (bootstrap only), owner (migrations), app (least privilege)
POSTGRES_PASSWORD=change-me-postgres
BLUEMEAL_OWNER_PASSWORD=change-me-owner
BLUEMEAL_APP_PASSWORD=change-me-app
DB_POOL_SIZE=100

# --- Redis
REDIS_PASSWORD=change-me-redis

# --- Application secrets
# JWT HS256 key, at least 32 characters
BLUEMEAL_JWT_KEY=change-me-to-a-long-random-string-of-64-chars
# Column encryption keys "kid:base64(32 bytes)"; the first key is current. To rotate, add a new key in front.
BLUEMEAL_ENC_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# HMAC key for searchable hashes, base64 of at least 32 bytes
BLUEMEAL_HMAC_KEY=REPLACE_WITH_BASE64_32_BYTES
# Initial admin password (account "admin"; must be changed and MFA enabled at first login)
BLUEMEAL_ADMIN_PASSWORD=ChangeMe@2026!

# --- Sample data ([DỮ LIỆU MẪU]) for demo/training. Set false for production go-live.
SEED_SAMPLE_DATA=true

# --- Backup (SPEC §10.7)
BACKUP_PASSPHRASE=change-me-backup-passphrase
BACKUP_CRON=0 1 * * *
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=6
# Optional NAS mount path inside the backup container (mount it via an override file)
BACKUP_MIRROR_PATH=

# --- Integration: National Institute of Nutrition data portal (configured in the admin UI; default only)
VDD_BASE_URL=

# --- Dev tools
PGADMIN_PASSWORD=admin
