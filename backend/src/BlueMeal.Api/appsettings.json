{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "",
    "Migration": "",
    "Redis": ""
  },
  "Database": { "AutoMigrate": true, "Seed": true },
  "Seed": { "SampleData": true },
  "Auth": { "Issuer": "bluemeal", "Audience": "bluemeal-web", "AccessTokenMinutes": 15, "CookieSecure": true },
  "Jobs": { "Mode": "Quartz" },
  "App": { "PublicUrl": "https://localhost" },
  "Mfa": { "Issuer": "BlueMeal" },
  "RateLimit": { "PerMinute": 600, "AuthPerMinute": 20 },
  "Limits": { "MaxRequestBodyBytes": 26214400 }
}
